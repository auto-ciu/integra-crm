{
  "name": "@integra/crm-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Integra Scientific CRM — Twenty App (Requirement 4): flywheel data model, views, page layouts, RenewalBanner / RenewalCountWidget front components, nightly urgency script.",
  "scripts": {
    "verify": "node verify-model.mjs",
    "typecheck": "tsc --noEmit -p .",
    "build": "twenty dev:build",
    "dev": "twenty dev",
    "plan": "twenty plan",
    "deploy": "twenty apply",
    "nightly": "node ops/nightly-status.mjs",
    "nightly:dry": "node ops/nightly-status.mjs --dry-run",
    "stages:sync": "node ops/sync-opportunity-stages.mjs",
    "stages:dry": "node ops/sync-opportunity-stages.mjs --dry-run",
    "streams:seed": "node ops/seed-product-streams.mjs",
    "streams:dry": "node ops/seed-product-streams.mjs --dry-run",
    "stream-stages:seed": "node ops/seed-stream-stages.mjs",
    "stream-stages:dry": "node ops/seed-stream-stages.mjs --dry-run",
    "pricing:seed": "node ops/seed-pricing.mjs",
    "pricing:dry": "node ops/seed-pricing.mjs --dry-run",
    "pricing:publish": "node ops/publish-pricing.mjs",
    "pricing:preview": "node ops/trigger-preview.mjs",
    "pricing:preview:dry": "node ops/trigger-preview.mjs --dry-run",
    "quote": "node ops/build-quote.mjs",
    "replies:seed": "node ops/seed-reply-templates.mjs",
    "replies:dry": "node ops/seed-reply-templates.mjs --dry-run",
    "digests": "node ops/generate-all-digests.mjs",
    "digests:dry": "node ops/generate-all-digests.mjs --dry-run",
    "discover": "node ops/discover-leads.mjs",
    "discover:dry": "node ops/discover-leads.mjs --dry-run",
    "leads:import": "node ops/import-leads.mjs",
    "leads:import:dry": "node ops/import-leads.mjs --dry-run",
    "leads:enrich": "node ops/enrich-all-new.mjs",
    "leads:enrich:dry": "node ops/enrich-all-new.mjs --dry-run",
    "training:seed": "node ops/seed-training-events.mjs",
    "training:dry": "node ops/seed-training-events.mjs --dry-run",
    "stripe:sync": "node ops/sync-to-stripe.mjs",
    "stripe:dry": "node ops/sync-to-stripe.mjs --dry-run",
    "research:seed": "node ops/seed-research-briefs.mjs",
    "research:dry": "node ops/seed-research-briefs.mjs --dry-run"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "twenty-client-sdk": "~2.41.0",
    "twenty-sdk": "~2.41.0",
    "typescript": "^5",
    "zod": "^4.6.5"
  }
}
